{
  "name": "MutateTheWorld",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "ActionRequest": { "$className": "RemoteFunction" },
        "StateUpdate": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" },
        "HeistEvent": { "$className": "RemoteEvent" },
        "TradeEvent": { "$className": "RemoteEvent" },
        "MutationEvent": { "$className": "RemoteEvent" },
        "Announcement": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage"
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "MutateUI": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false,
          "IgnoreGuiInset": true,
          "ZIndexBehavior": "Sibling"
        }
      }
    },
    "Workspace": {
      "$properties": {
        "FallenPartsDestroyHeight": -300
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 2.2
      }
    }
  }
}
